# [배포용 환경변수 템플릿] GitHub Actions Secrets에서 빌드 시 자동 주입됩니다.
VITE_API_BASE_URL=/gilmok-demo
VITE_AUTH_BASE_URL=/gilmok-demo

# 대기열 플랫폼 서버 주소 (SDK 연동 및 대기열 모달 연결, VM 1)

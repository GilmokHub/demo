# [로컬 개발 환경변수 템플릿] 로컬 실행 시 .env.development 로 복사하여 사용합니다.

# Vite 프록시 목적지 주소 (로컬 백엔드 서버)
VITE_BACKEND_PROXY_TARGET=http://localhost:8081
VITE_QUEUE_PROXY_TARGET=http://localhost:8082

# 브라우저 API 호출 베이스 경로 (Vite 프록시 활용)
VITE_API_BASE_URL=/gilmok-demo
VITE_AUTH_BASE_URL=/gilmok-demo

# 대기열 플랫폼 서버 주소 (SDK 연동)
VITE_QUEUE_SERVER_URL=http://localhost:8082

# 대기열 플랫폼 관리자 콘솔 바로가기 주소
VITE_PLATFORM_CONSOLE_URL=http://localhost:3031
